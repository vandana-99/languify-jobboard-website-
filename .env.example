# Configure these on Vercel under Project Settings > Environment Variables.
# Keep APIFY_TOKEN server-only and mark it Sensitive. Never add NEXT_PUBLIC_.
APIFY_TOKEN=

# For automatic updates, use the ID of the scheduled saved Apify task.
APIFY_TASK_ID=

# For multiple platforms, comma-separated saved task IDs (up to 5).
# This takes priority over APIFY_TASK_ID. Each actor's output must match lib/jobs.ts.
# Example only: linkedin-task-id,naukri-task-id
APIFY_TASK_IDS=

# Optional fixed dataset instead of a task; this does not follow new runs.
APIFY_DATASET_ID=

# Live deployments should show an unavailable state until the feed is connected.
DEMO_MODE=false
